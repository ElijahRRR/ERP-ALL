# 复制为 .env 本地使用；生产一律环境变量注入，.env 不进 git。
#
# ⚠️ 这里的占位值（dev-only-change-me / 口令＝角色名 / redis 无口令）自 RS-02a 起
# 会被 Settings 的启动自检**拒绝**，进程直接起不来。两条路：
#   ① 本地开发：保留占位值，另设 ERP_ALLOW_INSECURE_DEFAULTS=true（见文件末尾）
#   ② 真部署：全部换成强随机值（openssl rand -hex 32），**不要**设那个开关
# 容器化部署不用本文件——compose 从 infra/.env 注入，见 infra/.env.example。
ERP_ENV=dev
ERP_DEBUG=true
ERP_DATABASE_URL=postgresql+psycopg://erp_app:erp_app@localhost:5432/erp_all
ERP_MIGRATOR_DATABASE_URL=postgresql+psycopg://erp_migrator:erp_migrator@localhost:5432/erp_all
ERP_REDIS_URL=redis://localhost:6379/0
ERP_JWT_SECRET=dev-only-change-me
ERP_CREDENTIAL_KEY=dev-only-change-me
ERP_LOG_JSON=false
# Swagger UI（/api/docs）。独立开关，**不从 ERP_ENV 派生**——否则「想看接口文档」
# 和「重开弱密钥放行」会变成同一个动作。默认关（API 端口内网可达而该页无鉴权）。
ERP_DOCS_ENABLED=true

# 放行开关：显式声明「我知道这套是弱密钥，这是一次性的本地/CI 环境」。
# ERP_ENV=prod 时**无效**——prod 下没有任何办法带着默认密钥启动。
ERP_ALLOW_INSECURE_DEFAULTS=true
