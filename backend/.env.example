# 复制为 .env 本地使用；生产一律环境变量注入，.env 不进 git
ERP_ENV=dev
ERP_DEBUG=true
ERP_DATABASE_URL=postgresql+psycopg://erp_app:erp_app@localhost:5432/erp_all
ERP_MIGRATOR_DATABASE_URL=postgresql+psycopg://erp_migrator:erp_migrator@localhost:5432/erp_all
ERP_REDIS_URL=redis://localhost:6379/0
ERP_JWT_SECRET=dev-only-change-me
ERP_CREDENTIAL_KEY=dev-only-change-me
ERP_LOG_JSON=false
